{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "a8-devtools",
  "version": "0.1.0",
  "identifier": "com.a8.devtools",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "a8-devtools 开发者工作台",
        "width": 1240,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
